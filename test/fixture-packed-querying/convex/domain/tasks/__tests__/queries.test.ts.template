import assert from 'node:assert/strict'
import { test } from 'node:test'
import { convexTest } from 'convex-test'
import { anyApi } from 'convex/server'
import { z } from 'zod'
import schema from '../../../schema'
import { tasks } from '../schema'
import { contract } from '../contracts'

test('domain DTO contracts and conditional false/zero/empty-string routes remain executable', async () => {
 const t = convexTest(schema, {
  './_generated/server.ts': () => import('../../../_generated/server'),
  './api/tasks.ts': () => import('../../../api/tasks'),
 })
 const row = await t.run(async ctx => {
  const id = await ctx.db.insert('tasks', { ordinal: 9, tenant: 'a', authorized: true, department: 'support', status: 'open', active: false, priority: 0, code: '', secret: 'PRIVATE' })
  return ctx.db.get(id)
 })
 assert.ok(row)
 assert.deepEqual(tasks.toPublicDto(row), { ordinal: 9 })
 assert.deepEqual(tasks.toPublicDto(row, true), { ordinal: 9, _id: row._id })
 const extended = tasks.toPublicDto(row, { _id: true, extend: { url: z.string() }, values: { url: 'https://fixture.test/task' } })
 assert.deepEqual(tasks.dto({ _id: true, extend: { url: z.string() } }).parse(extended), extended)
 assert.throws(() => contract.queries.list.input.parse({ numItems: 1, cursor: null, filters: { unknown: 1 } }))
 const client = t.withIdentity({ subject: 'reader', org_id: 'a', role: 'reader' })
 for (const filters of [{ active: false }, { priority: 0 }, { code: '' }]) {
  const result = contract.queries.conditional.result.parse(await client.query(anyApi.api.tasks.conditional, { numItems: 7, cursor: null, filters }))
  assert.deepEqual(result.page, [{ ordinal: 9, _id: row._id }])
 }
})
