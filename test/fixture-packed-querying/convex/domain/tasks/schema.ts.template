import { k } from 'cvx-kit/k'
import { kTable } from 'cvx-kit/table'

export const tasks = kTable('tasks', {
 ordinal: k.number(), tenant: k.string(), department: k.string(), status: k.string(),
 active: k.boolean(), priority: k.number(), authorized: k.boolean(), code: k.string(),
 reference: k.id('tasks').nullable().optional(), required: k.id('labels').optional(), secret: k.string(),
}, { serverFields: ['tenant', 'authorized', 'secret'], publicFields: ['ordinal'] })
export const labels = kTable('labels', {
 ordinal: k.number(), tenant: k.string(), authorized: k.boolean(), name: k.string(), task: k.id('tasks').optional(),
}, { serverFields: ['tenant', 'authorized'], publicFields: ['ordinal', 'name'] })
export const edges = kTable('edges', {
 task: k.id('tasks'), label: k.id('labels'), authorized: k.boolean(), ordinal: k.number(),
}, { serverFields: ['authorized'], publicFields: ['ordinal'] })
