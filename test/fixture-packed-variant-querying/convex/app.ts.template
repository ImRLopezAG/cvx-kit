// Count policy entry, an observable native managed-read boundary. This is not physical I/O accounting.
let creditorPolicyReads = 0
const auth = createAuthFunctions<DataModel, 'finance' | 'reader' | 'taskOnly' | 'targetOnly'>({
 query, mutation, action, internalQuery, internalMutation, internalAction,
 getAuthUser: async ctx => { const identity = await ctx.auth.getUserIdentity(); return identity ? { id: identity.subject } : null },
 mapRole: role => role === 'finance' || role === 'reader' || role === 'taskOnly' || role === 'targetOnly' ? role : null,
 adminRoles: [],
 security: { defaultPolicy: 'deny', rules: bundle => {
  const member = async (ctx: { db: import('convex/server').GenericDatabaseReader<DataModel> }) =>
   ctx.db.query('members').withIndex('by_principal', q => q.eq('principal', bundle.user.id)).unique()
  const active = async (ctx: { db: import('convex/server').GenericDatabaseReader<DataModel> }) =>
   bundle.org.organizationId === 'fixture' && (await member(ctx))?.active === true
  const finance = async (ctx: { db: import('convex/server').GenericDatabaseReader<DataModel> }) => bundle.role === 'finance' && (await member(ctx))?.finance === true
  const scoped = async (ctx: { db: import('convex/server').GenericDatabaseReader<DataModel> }, row: { allowed: boolean; department?: string }) => {
   const current = await member(ctx)
   return row.allowed && bundle.org.organizationId === 'fixture' && current?.active === true && (row.department === undefined || row.department === current.department)
  }
  const target = async (ctx: { db: import('convex/server').GenericDatabaseReader<DataModel> }, row: { allowed: boolean; department?: string }) => bundle.role !== 'taskOnly' && await scoped(ctx, row)
  const clientAccess = async (ctx: { db: import('convex/server').GenericDatabaseReader<DataModel> }, id: import('./_generated/dataModel').Id<'clients'>) => {
   const row = await ctx.db.get('clients', id)
   return row !== null && await target(ctx, row)
  }
  return {
   members: { read: async () => true },
   clients: { read: target, insert: async () => true },
   creditors: { read: async (ctx, row) => { creditorPolicyReads++; return await target(ctx, row) && (row.department === undefined || await finance(ctx)) }, insert: async () => true },
   payments: { read: async (ctx, row) => await finance(ctx) && await target(ctx, row) && (!row.dependentClient || await clientAccess(ctx, row.clientId)), insert: async ctx => await finance(ctx) && await active(ctx), modify: async (ctx, row) => await finance(ctx) && row.allowed && await active(ctx) },
   ledger: { read: async (ctx, row) => await finance(ctx) && await target(ctx, row) && (!row.clientId || await clientAccess(ctx, row.clientId)), modify: async (ctx, row) => await finance(ctx) && await target(ctx, row) },
   tasks: { read: async (ctx, row) => bundle.role !== 'targetOnly' && await scoped(ctx, row), insert: async ctx => bundle.role !== 'targetOnly' && await active(ctx), modify: async (ctx, row) => bundle.role !== 'targetOnly' && await scoped(ctx, row) },
   leads: { read: target }, contacts: { read: target },
   deals: { read: async (ctx, row) => await target(ctx, row) && await clientAccess(ctx, row.clientId) },
   taskAudits: { insert: async ctx => await active(ctx), read: async () => false },
   attachments: { read: async (ctx, row) => row.allowed && await active(ctx) },
   paymentAttachments: { read: async (ctx, row) => row.allowed && await active(ctx) },
   audits: { read: async () => true, insert: async () => true },
  }
 } },
})
