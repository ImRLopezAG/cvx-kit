 if (!member?.active || bundle.org.organizationId !== 'fixture') throw new Error('TASK_MEMBERSHIP_REVOKED')
 await authorizeLink(ctx, input.rel)
 const row = tasks.storage.parse({ ...input, allowed: true, department: member.department, linkAllowed: true, secret: 'PRIVATE-TASK-EVIDENCE' })
 const id = await ctx.db.insert('tasks', row)
 await ctx.db.insert('taskAudits', { taskId: id, operation: 'create', previous: null, next: input.rel ?? null })
 return id
} })
