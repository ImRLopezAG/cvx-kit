// Host link authorization is independent of query readability. Normalization identifies
// the real policy-owned native table before the authorized reader fetches its row.
async function authorizeLink(ctx: { db: import('convex/server').GenericDatabaseReader<DataModel> }, rel: z.output<typeof taskRel>) {
 if (rel == null) return
 for (const table of targetTables) {
  const id = ctx.db.normalizeId(table, rel)
  if (id === null) continue
  const row = await ctx.db.get(table, id)
  if (!row) throw new Error('TASK_TARGET_UNAVAILABLE')
  if (row.linkAllowed === false) throw new Error('TASK_LINK_FORBIDDEN')
  return
 }
 throw new Error('TASK_TARGET_TABLE_INVALID')
}
