import { defineSchema } from 'convex/server'
import { k } from 'cvx-kit/k'
import { kTable, kVariantTable } from 'cvx-kit/table'

const access = { department: k.string().optional(), linkAllowed: k.boolean().optional() }
export const clients = kTable('clients', { name: k.string(), allowed: k.boolean(), ...access }, { publicFields: ['name'] })
export const creditors = kTable('creditors', { name: k.string(), allowed: k.boolean(), ...access }, { publicFields: ['name'] })
export const attachments = kTable('attachments', { name: k.string(), allowed: k.boolean(), evidence: k.string() }, { publicFields: ['name'] })
export const paymentAttachments = kTable('paymentAttachments', { paymentId: k.id('payments'), attachmentId: k.id('attachments'), allowed: k.boolean() }, { publicFields: ['paymentId', 'attachmentId'] })
paymentAttachments.table.index('by_payment', ['paymentId'])
export const payments = kVariantTable('payments', k.discriminatedUnion('type', [
 k.object({ type: k.literal('client_draft'), clientId: k.id('clients'), amountCents: k.int().min(1), draftDate: k.int().min(0), allowed: k.boolean(), external: k.string(), ...access, dependentClient: k.boolean().optional() }),
 k.object({ type: k.literal('creditor_payment'), clientId: k.id('clients'), creditorId: k.id('creditors'), amountCents: k.int().min(1), allowed: k.boolean(), external: k.string(), ...access, dependentClient: k.boolean().optional() }),
]), { discriminator: 'type', timestamps: true, variants: {
 client_draft: { serverFields: ['allowed', 'external', 'department', 'linkAllowed', 'dependentClient'], commandFields: ['clientId', 'amountCents', 'draftDate'], publicFields: ['clientId', 'amountCents', 'draftDate'] },
 creditor_payment: { serverFields: ['allowed', 'external', 'department', 'linkAllowed', 'dependentClient'], commandFields: ['clientId', 'creditorId', 'amountCents'], publicFields: ['clientId', 'creditorId', 'amountCents'] },
} })
payments.table.index('by_client', ['clientId']).index('by_type_client', ['type', 'clientId']).index('by_creditor', ['creditorId'])
export const ledger = kVariantTable('ledger', k.discriminatedUnion('type', [
 k.object({ type: k.literal('payment'), clientId: k.id('clients').optional(), paymentId: k.id('payments').optional(), amountCents: k.int().min(1), allowed: k.boolean(), evidence: k.string(), ...access, createdAt: k.int().min(0).safe(), recordedAt: k.int().min(0).safe() }),
 k.object({ type: k.literal('adjustment'), clientId: k.id('clients').optional(), reason: k.string(), amountCents: k.int(), allowed: k.boolean(), evidence: k.string(), ...access, createdAt: k.int().min(0).safe(), recordedAt: k.int().min(0).safe() }),
]), { discriminator: 'type', timestamps: false, variants: {
 payment: { serverFields: ['allowed', 'evidence', 'department', 'linkAllowed', 'createdAt', 'recordedAt'], commandFields: ['clientId', 'paymentId', 'amountCents'], publicFields: ['clientId', 'paymentId', 'amountCents'] },
 adjustment: { serverFields: ['allowed', 'evidence', 'department', 'linkAllowed', 'createdAt', 'recordedAt'], commandFields: ['clientId', 'reason', 'amountCents'], publicFields: ['clientId', 'reason', 'amountCents', 'createdAt', 'recordedAt'] },
} })
export const members = kTable('members', { principal: k.string(), active: k.boolean(), department: k.string(), finance: k.boolean() }, { publicFields: [] })
export const audits = kTable('audits', { paymentId: k.id('payments'), operation: k.string() }, { publicFields: [] })
export const targetTables = ['tasks', 'leads', 'contacts', 'clients', 'creditors', 'deals', 'payments', 'ledger'] as const
export const taskRel = k.union([k.id('tasks'), k.id('leads'), k.id('contacts'), k.id('clients'), k.id('creditors'), k.id('deals'), k.id('payments'), k.id('ledger')]).nullable().optional()
export const tasks = kTable('tasks', { name: k.string(), status: k.enum(['open', 'done']), rel: taskRel, allowed: k.boolean(), department: k.string(), linkAllowed: k.boolean(), secret: k.string() }, {
 serverFields: ['allowed', 'department', 'linkAllowed', 'secret'], commandFields: ['name', 'status', 'rel'], publicFields: ['name', 'status', 'rel'],
})
tasks.table.index('by_rel', ['rel'])
const targetFields = () => ({ name: k.string(), allowed: k.boolean(), ...access, secret: k.string() })
export const leads = kTable('leads', targetFields(), { publicFields: ['name'] })
export const contacts = kTable('contacts', targetFields(), { publicFields: ['name'] })
export const deals = kTable('deals', { ...targetFields(), clientId: k.id('clients') }, { publicFields: ['name'] })
export const taskAudits = kTable('taskAudits', { taskId: k.id('tasks'), operation: k.string(), previous: taskRel, next: taskRel }, { publicFields: [] })
const taskAuditTable = taskAudits.table.index('by_task', ['taskId'])
const memberTable = members.table.index('by_principal', ['principal'])
const auditTable = audits.table.index('by_payment', ['paymentId'])
export default defineSchema({ clients: clients.table, creditors: creditors.table, payments: payments.table, ledger: ledger.table, attachments: attachments.table, paymentAttachments: paymentAttachments.table,
 tasks: tasks.table, leads: leads.table, contacts: contacts.table, deals: deals.table, taskAudits: taskAuditTable,
 members: memberTable,
 audits: auditTable,
})
