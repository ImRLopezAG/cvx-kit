import { z } from 'zod'
import { defineRelations } from 'cvx-kit/relations'
import type { Id, Doc } from './convex/_generated/dataModel'
import { relations, tables, paymentPage, creditorPage, querying } from './convex/relations'
import { payments } from './convex/schema'
function accepts<T>(_value: T) {}
declare const page: z.output<typeof paymentPage>
for (const row of page.page) {
 accepts<Id<'payments'>>(row._id)
 accepts<Id<'clients'>>(row.clientId)
 if (row.type === 'creditor_payment') {
  accepts<Id<'creditors'>>(row.creditorId)
  // @ts-expect-error other-branch fields remain absent after relation composition
  row.draftDate
 } else {
  accepts<number>(row.draftDate)
  // @ts-expect-error draft DTO must not acquire creditorId
  row.creditorId
 }
 // @ts-expect-error private storage evidence is never public
 row.external
}
declare const stored: Doc<'payments'>
if (stored.type === 'creditor_payment') accepts<Id<'creditors'>>(stored.creditorId)
else {
 // @ts-expect-error sanctioned native codegen must preserve the branch distinction
 stored.creditorId
}
declare const scoped: z.output<typeof creditorPage>
for (const creditor of scoped.page) for (const payment of creditor.payments.page) {
 accepts<'creditor_payment'>(payment.type)
 accepts<Id<'creditors'>>(payment.creditorId)
 // @ts-expect-error target-scoped relation excludes the other branch
 payment.draftDate
}
defineRelations(tables, (r, branch) => {
 // @ts-expect-error unknown branch scope
 branch('payments', 'unknown')
 // @ts-expect-error branch-only fields cannot be addressed through the common field view
 r.payments.creditorId
 // @ts-expect-error native join IDs remain tied to their target table
 r.one.creditors({ from: r.payments.clientId, to: r.creditors._id })
 return {}
})
// @ts-expect-error branch-only masks require variants
relations.tables.payments.paginationOpts({ creditorId: true })
// @ts-expect-error unknown variant mask
relations.tables.payments.paginationOpts({ variants: { unknown: { creditorId: true } } })
// @ts-expect-error unknown nested evidence fields are not branch scalar mask keys
relations.tables.payments.paginationOpts({ variants: { creditor_payment: { providerId: true } } })
// @ts-expect-error wrong branch does not own creditorId
relations.tables.payments.paginationOpts({ variants: { client_draft: { creditorId: true } } })
// @ts-expect-error private field cannot become a relation selection
relations.tables.payments.pageDto({ external: true })
declare const engine: ReturnType<typeof querying>
// @ts-expect-error unguarded branch-only predicates
engine.payments.where({ creditorId: 'not-an-id' })
// @ts-expect-error unknown branch predicate
engine.payments.where({ variant: { tag: 'unknown', filters: {} } })
declare const wrongId: Id<'clients'>
// @ts-expect-error a client ID cannot populate a creditor join key
engine.payments.where({ variant: { tag: 'creditor_payment', filters: { creditorId: wrongId } } })
declare const update: z.output<typeof payments.tools.update>
if (update.data.type === 'client_draft') {
 accepts<number | undefined>(update.data.draftDate)
 // @ts-expect-error tagged partial contracts exclude absent branch fields
 update.data.creditorId
}

// Installed public API acceptance for ordinary native-ID unions.
import { zodTable } from 'cvx-kit/zod-table'
import { taskPage, taskChildPage, taskOptions } from './convex/relations'
import { tasks, ledger } from './convex/schema'
type TaskRow = z.output<typeof taskPage>['page'][number]
type NativeLink = Id<'tasks'> | Id<'leads'> | Id<'contacts'> | Id<'clients'> | Id<'creditors'> | Id<'deals'> | Id<'payments'> | Id<'ledger'> | null | undefined
declare const taskRow: TaskRow
declare const nativeLink: NativeLink
accepts<NativeLink>(taskRow.rel)
accepts<TaskRow['rel']>(nativeLink)
accepts<z.output<ReturnType<typeof tasks.dto<true>>> | null>(taskRow.referenceTask)
accepts<Id<'clients'> | undefined>(taskRow.client?._id)
accepts<Id<'tasks'>>(taskRow.referencingTasks.page[0]._id)
accepts<Id<'tasks'>>(taskRow.client!.tasks.page[0]._id)
accepts<string>(taskRow.referencingTasks.continueCursor)
accepts<boolean>(taskRow.referencingTasks.isDone)
accepts<z.output<typeof taskChildPage>['page'][number]['_id']>(taskRow._id)
accepts<'client_draft' | 'creditor_payment' | undefined>(taskRow.payment?.type)
accepts<'client_draft' | undefined>(taskRow.draftPayment?.type)
accepts<'payment' | 'adjustment' | undefined>(taskRow.ledgerEntry?.type)
accepts<'adjustment' | undefined>(taskRow.adjustment?.type)
// @ts-expect-error task policy evidence is absent at generated public boundary
taskRow.secret
// @ts-expect-error department is not public
taskRow.department
// @ts-expect-error inverse child policy evidence is absent
taskRow.referencingTasks.page[0].allowed
// @ts-expect-error undeclared relation selection
relations.tables.tasks.pageDto({ invented: true })
// @ts-expect-error private scalar cannot be selected as a relation
relations.tables.tasks.pageDto({ secret: true })
// @ts-expect-error private field is excluded from this endpoint's generated filter mask
accepts<z.output<typeof taskOptions>>({ numItems: 2, cursor: null, filters: { department: 'A' } })
declare const outsiderId: Id<'attachments'>
// @ts-expect-error ninth-table ID cannot populate the native command union
accepts<z.output<typeof tasks.commandInput>>({ name: 'wrong', status: 'open', rel: outsiderId })
declare const taskCommand: z.output<typeof tasks.commandInput>
// @ts-expect-error server-owned command evidence
taskCommand.secret
declare const ledgerStored: Doc<'ledger'>
accepts<number>(ledgerStored.createdAt)
accepts<number>(ledgerStored.recordedAt)
declare const ledgerCommand: z.output<typeof ledger.commandInput>
// @ts-expect-error explicit timestamp excluded from command mask
ledgerCommand.createdAt
declare const ledgerUpdate: z.output<typeof ledger.tools.update>
// @ts-expect-error explicit timestamp excluded from update mask
ledgerUpdate.data.recordedAt
if (taskRow.ledgerEntry?.type === 'payment') {
 // @ts-expect-error payment public boundary redacts explicit timestamp
 taskRow.ledgerEntry.createdAt
} else if (taskRow.ledgerEntry?.type === 'adjustment') {
 accepts<number>(taskRow.ledgerEntry.createdAt)
 accepts<number>(taskRow.ledgerEntry.recordedAt)
}
defineRelations(tables, (r, branch) => {
 r.tasks.rel.forTable('clients').forTable('clients')
 // @ts-expect-error invalid native union member
 r.tasks.rel.forTable('attachments')
 // @ts-expect-error repeated selection cannot widen
 r.tasks.rel.forTable('clients').forTable('tasks')
 // @ts-expect-error scalar field cannot narrow to an ID member
 r.tasks.status.forTable('tasks')
 // @ts-expect-error branch-only source narrowing explicitly deferred
 branch('payments', 'creditor_payment').creditorId.forTable('creditors')
 // @ts-expect-error narrowed source junction explicitly deferred
 r.tasks.rel.forTable('clients').through(r.clients._id)
 // @ts-expect-error narrowed junction leg explicitly deferred
 r.clients._id.through(r.tasks.rel.forTable('clients'))
 // @ts-expect-error wrong native target table
 r.one.tasks({ from: r.tasks.rel.forTable('clients'), to: r.tasks._id })
 return {}
})
const probes = zodTable('tasks', id => ({ rel: z.union([id('tasks'), id('unregistered')]), mixed: z.union([id('tasks'), z.string()]), single: id('tasks').nullable().optional(), duplicate: z.union([id('tasks'), id('tasks')]), scalar: z.union([z.string(), z.number()]) }))
defineRelations({ tasks: probes }, r => {
 // @ts-expect-error native member must also be registered
 r.tasks.rel.forTable('unregistered')
 // @ts-expect-error mixed scalar-ID union remains unsupported
 r.tasks.mixed.forTable('tasks')
 // @ts-expect-error ordinary scalar unions retain exact compatibility
 r.one.tasks({ from: r.tasks.scalar, to: r.tasks._id })
 return { tasks: {
  singleReference: r.one.tasks({ from: r.tasks.single.forTable('tasks'), to: r.tasks._id }),
  duplicateReference: r.one.tasks({ from: r.tasks.duplicate.forTable('tasks'), to: r.tasks._id }),
 } }
})

declare const clientDto: NonNullable<TaskRow['client']>
accepts<z.output<ReturnType<typeof tables.clients.dto<true>>>>(clientDto)
declare const ledgerInsert: z.output<typeof ledger.insertSchema>
// @ts-expect-error server timestamp absent from generated insert
ledgerInsert.createdAt
declare const ledgerPartial: z.output<typeof ledger.updateSchema>
// @ts-expect-error server timestamp absent from generated partial update
ledgerPartial.recordedAt
const installedInversePages = {
 tasks: relations.tables.tasks.pageDto({ referencingTasks: true }),
 leads: relations.tables.leads.pageDto({ tasks: true }),
 contacts: relations.tables.contacts.pageDto({ tasks: true }),
 clients: relations.tables.clients.pageDto({ tasks: true }),
 creditors: relations.tables.creditors.pageDto({ tasks: true }),
 deals: relations.tables.deals.pageDto({ tasks: true }),
 payments: relations.tables.payments.pageDto({ tasks: true }),
 ledger: relations.tables.ledger.pageDto({ tasks: true }),
}
declare const inversePayment: z.output<typeof installedInversePages.payments>['page'][number]
accepts<Id<'tasks'>>(inversePayment.tasks.page[0]._id)
accepts<Id<'payments'>>(inversePayment._id)
declare const inverseLedger: z.output<typeof installedInversePages.ledger>['page'][number]
accepts<Id<'tasks'>>(inverseLedger.tasks.page[0]._id)
accepts<'payment' | 'adjustment'>(inverseLedger.type)
