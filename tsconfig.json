{
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["ES2025", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"noEmit": true
	},
	"include": ["src", "test"]
}
